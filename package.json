{
    "name": "@jx3box/jx3-skill-parser",
    "version": "0.1.7",
    "description": "A package used to parse jx3 game skill script",
    "authors": [
        "x3zvawq <x3zvawq@gmail.com>"
    ],
    "main": "dist/index.js",
    "devDependencies": {
        "@types/node": "24.19.1",
        "@typescript-eslint/eslint-plugin": "6.13.2",
        "@typescript-eslint/parser": "6.13.2",
        "eslint": "8.55.0",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-prettier": "5.0.1",
        "eslint-plugin-sort-imports-es6-autofix": "0.6.0",
        "mocha": "10.2.0",
        "prettier": "3.1.0",
        "typescript": "5.9.3",
        "tsdown": "0.23.0"
    },
    "dependencies": {
        "iconv-lite": "^0.6.3",
        "pinyin-pro": "^3.19.5",
        "wasmoon-lua5.1": "1.18.12"
    },
    "license": "MIT",
    "scripts": {
        "test": "mocha --parallel test/*.test.js",
        "lint": "prettier --write . && eslint . --fix --cache",
        "lint:nofix": "eslint .",
        "start": "tsdown --watch",
        "build": "tsdown",
        "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\"",
        "typecheck": "tsc --noEmit",
        "test:package": "node scripts/test-package.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JX3BOX/jx3-skill-parser.git"
    },
    "homepage": "https://github.com/JX3BOX/jx3-skill-parser.git",
    "bugs": {
        "url": "https://github.com/JX3BOX/jx3-skill-parser/issues"
    },
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20"
    }
}
